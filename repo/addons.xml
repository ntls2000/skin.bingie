<?xml version='1.0' encoding='utf-8'?>
<addons>
    <addon id="skin.bingie" version="2.0.4~beta2" name="Bingie" provider-name="matke">
        <requires>
            <import version="5.17.0" addon="xbmc.gui" />
            <import addon="script.bingie.helper" version="1.1.2" />
            <import addon="script.bingie.toolbox" version="1.0.1" />
            <import addon="script.bingie.widgets" version="1.0.2" />
            <import addon="script.skinshortcuts" version="3.0.4" />
            <import addon="resource.images.studios.coloured" version="1.0.0" />
            <import addon="plugin.video.tmdb.bingie.helper" version="1.0.1" />
            <import addon="plugin.program.autocompletion" version="2.1.3" />
        </requires>
        <extension debugging="false" defaultthemename="Textures.xbt" effectslowdown="1" point="xbmc.gui.skin">
            <res aspect="16:9" default="true" folder="1080i" height="1080" width="1920" />
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Kodi skin with Netflix layout.</summary>
            <summary lang="zh_CN">Netflix 布局 Kodi 皮肤。</summary>
            <summary lang="es_ES">Kodi con diseño Netflix.</summary>
            <summary lang="es_AR">Kodi con diseño Netflix.</summary>
            <summary lang="es_MX">Kodi con diseño Netflix.</summary>
            <description lang="en_GB">Bingie – The home of your favorite movies and shows!</description>
            <description lang="zh_CN">Bingie -你最喜欢的电影和节目的主界面！</description>
            <description lang="es_ES">Bingie - tu hogar de películas y series favoritas!</description>
            <description lang="es_AR">Bingie - tu hogar de películas y series favoritas!</description>
            <description lang="es_MX">Bingie - tu hogar de películas y series favoritas!</description>
            <platform>all</platform>
            <license>GPL v2.0</license>
            <forum />
            <source />
            <assets>
                <icon>resources/icon.png</icon>
                <fanart>resources/fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="repository.ntls2000.bingie" name="Bingie - Dépôt de mises à jour" version="1.0.1" provider-name="ntls2000">
        <extension point="xbmc.addon.repository" name="Bingie - Dépôt de mises à jour">
            <dir>
                <info compressed="false">https://raw.githubusercontent.com/ntls2000/skin.bingie/omega/repo/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/ntls2000/skin.bingie/omega/repo/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/ntls2000/skin.bingie/omega/repo/</datadir>
                <hashes>false</hashes>
            </dir>
            <dir minversion="20.9.1">
                <info compressed="false">https://raw.githubusercontent.com/matke-84/repository.bingie/main/omega/addons.xml</info>
                <checksum>https://raw.githubusercontent.com/matke-84/repository.bingie/main/omega/addons.xml.md5</checksum>
                <datadir zip="true">https://raw.githubusercontent.com/matke-84/repository.bingie/main/omega/</datadir>
                <hashes>false</hashes>
            </dir>
        </extension>
        <extension point="xbmc.addon.metadata">
            <summary lang="en_GB">Kodi repository for Bingie skin updates</summary>
            <summary lang="fr_FR">Dépôt Kodi pour installer et mettre à jour Bingie</summary>
            <description lang="fr_FR">Installer le skin Bingie et recevoir ses prochaines versions depuis Kodi.</description>
            <description lang="en_GB">Install and update the Bingie skin directly from Kodi.</description>
            <platform>all</platform>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
        </extension>
    </addon>
    <addon id="script.bingie.toolbox" name="Bingie Toolbox" version="1.0.1" provider-name="matke">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="xbmc.addon" version="12.0.0" />
            <import addon="script.module.simplejson" version="3.3.0" />
            <import addon="script.module.simplecache" version="1.0.0" />
        </requires>
        <extension point="xbmc.python.library" library="default.py" />
        <extension point="xbmc.python.pluginsource" library="plugin.py" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Bingie Toolbox</summary>
            <description>Toolbox for Bingie skin.</description>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
            <language />
            <platform>all</platform>
            <license>GPL v2.0</license>
            <forum />
            <website />
            <source />
        </extension>
    </addon>
    <addon id="script.bingie.widgets" name="Bingie Widgets" version="1.0.2" provider-name="matke">
        <requires>
            <import addon="xbmc.python" version="3.0.0" />
            <import addon="xbmc.addon" version="12.0.0" />
            <import addon="script.module.simplecache" version="2.0.2" />
            <import addon="script.module.requests" version="2.9.1" />
            <import addon="script.module.infotagger" version="0.0.4" />
        </requires>
        <extension point="xbmc.python.pluginsource" library="plugin.py">
            <provides>video</provides>
        </extension>
        <extension library="service.py" point="xbmc.service" start="login" />
        <extension point="xbmc.addon.metadata">
            <summary lang="en">Bingie Widgets</summary>
            <description>Widgets for Bingie skin.</description>
            <assets>
                <icon>icon.png</icon>
                <fanart>fanart.jpg</fanart>
            </assets>
            <language />
            <platform>all</platform>
            <license>GPL v2.0</license>
            <forum />
            <website />
            <source />
        </extension>
    </addon>
    <addon id="script.module.bingie" name="bingie common" provider-name="jurialmunkey,matke" version="1.0.2">
        <requires>
            <import addon="xbmc.python" version="3.0.1" />
            <import addon="script.module.requests" version="2.9.1" />
            <import addon="script.module.infotagger" version="0.0.5" />
        </requires>
        <extension point="xbmc.python.module" library="resources/modules" />
        <extension point="xbmc.addon.metadata">
            <description lang="en_GB">Common code required by TMDb Bingie Helper.</description>
            <license>GPL-3.0-or-later</license>
            <website>https://github.com/matke-84/script.module.bingie</website>
            <assets>
                <icon>icon.png</icon>
            </assets>
        </extension>
    </addon>
</addons>
