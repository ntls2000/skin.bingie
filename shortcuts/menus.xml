<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL Kodi 22 / Skin Shortcuts v3 configuration.
     Main menu + power menu are based on Bingie v2 defaults.
     Do NOT merge this branch into omega until templates, submenu
     includes, widgets, dialogs and actions have been fully migrated. -->
<menus>
    <menu name="mainmenu" container="900">
        <item name="search">
            <label>$LOCALIZE[137]</label>
            <action>ActivateWindow(1109,return)</action>
            <icon>shortcuts/search.png</icon>
        </item>
        <item name="home">
            <label>$LOCALIZE[10000]</label>
            <action>ActivateWindow(home,return)</action>
            <icon>shortcuts/home.png</icon>
        </item>
        <item name="new">
            <label>$LOCALIZE[31227]</label>
            <action>ActivateWindow(1112,return)</action>
            <icon>shortcuts/new.png</icon>
        </item>
        <item name="shows">
            <label>$LOCALIZE[31566]</label>
            <action>ActivateWindow(1110,return)</action>
            <icon>shortcuts/tv.png</icon>
        </item>
        <item name="movies">
            <label>$LOCALIZE[342]</label>
            <action>ActivateWindow(1111,return)</action>
            <icon>shortcuts/clapperboard.png</icon>
        </item>
        <item name="categories">
            <label>$LOCALIZE[31025]</label>
            <action>ActivateWindow(1119,return)</action>
            <icon>shortcuts/categories.png</icon>
        </item>
        <item name="mylist">
            <label>$LOCALIZE[31534]</label>
            <action>ActivateWindow(1114,return)</action>
            <icon>shortcuts/mylist.png</icon>
        </item>
    </menu>
    <menu name="powermenu">
        <item name="settings">
            <label>$LOCALIZE[5]</label>
            <action>ActivateWindow(Settings)</action>
            <icon>common/settings1.png</icon>
        </item>
        <item name="reload">
            <label>$LOCALIZE[31501]</label>
            <action>ReloadSkin()</action>
            <icon>common/reload-skin.png</icon>
        </item>
        <item name="quit">
            <label>$LOCALIZE[31160]</label>
            <action>Quit()</action>
            <icon>common/exit1.png</icon>
        </item>
        <item name="reboot">
            <label>$LOCALIZE[13013]</label>
            <action>Reset()</action>
            <icon>common/reboot1.png</icon>
        </item>
        <item name="shutdown">
            <label>$LOCALIZE[13016]</label>
            <action>Powerdown()</action>
            <icon>common/shutdown1.png</icon>
        </item>
    </menu>
    <groupings>
        <group name="bingie" label="Bingie" icon="DefaultShortcut.png">
            <shortcut name="search" label="$LOCALIZE[137]" icon="shortcuts/search.png"><action>ActivateWindow(1109,return)</action></shortcut>
            <shortcut name="home" label="$LOCALIZE[10000]" icon="shortcuts/home.png"><action>ActivateWindow(home,return)</action></shortcut>
            <shortcut name="new" label="$LOCALIZE[31227]" icon="shortcuts/new.png"><action>ActivateWindow(1112,return)</action></shortcut>
            <shortcut name="shows" label="$LOCALIZE[31566]" icon="shortcuts/tv.png"><action>ActivateWindow(1110,return)</action></shortcut>
            <shortcut name="movies" label="$LOCALIZE[342]" icon="shortcuts/clapperboard.png"><action>ActivateWindow(1111,return)</action></shortcut>
            <shortcut name="categories" label="$LOCALIZE[31025]" icon="shortcuts/categories.png"><action>ActivateWindow(1119,return)</action></shortcut>
            <shortcut name="mylist" label="$LOCALIZE[31534]" icon="shortcuts/mylist.png"><action>ActivateWindow(1114,return)</action></shortcut>
            <shortcut name="customhub" label="$LOCALIZE[31252]" icon="shortcuts/widget.png"><action>ActivateWindow(1113,return)</action></shortcut>
            <shortcut name="something" label="$LOCALIZE[31385]" icon="shortcuts/something.png"><action>ActivateWindow(1118,return)</action></shortcut>
            <shortcut name="pvrhub" label="$LOCALIZE[32022]" icon="shortcuts/antenna.png" visible="PVR.HasTVChannels | PVR.HasRadioChannels"><action>ActivateWindow(1116,return)</action></shortcut>
            <shortcut name="music" label="$LOCALIZE[2]" icon="shortcuts/music.png" visible="Library.HasContent(music)"><action>ActivateWindow(1120,return)</action></shortcut>
            <shortcut name="weather" label="$LOCALIZE[12600]" icon="shortcuts/weather.png"><action>ActivateWindow(Weather)</action></shortcut>
            <shortcut name="skinsettings" label="$LOCALIZE[20077]" icon="common/skin-settings.png"><action>ActivateWindow(SkinSettings)</action></shortcut>
            <shortcut name="settings" label="$LOCALIZE[5]" icon="common/settings1.png"><action>ActivateWindow(Settings)</action></shortcut>
        </group>
        <group name="video" label="$LOCALIZE[32030]">
            <content source="nodes" target="video"/>
            <content source="playlists" target="video"/>
            <content source="sources" target="video"/>
            <content source="addons" target="video"/>
        </group>
        <group name="music" label="$LOCALIZE[32031]">
            <content source="nodes" target="music"/>
            <content source="playlists" target="music"/>
            <content source="addons" target="audio"/>
        </group>
        <group name="pvr" label="$LOCALIZE[32017]" visible="PVR.HasTVChannels | PVR.HasRadioChannels">
            <content source="pvr" target="tv"/>
            <content source="pvr" target="radio"/>
        </group>
        <group name="other" label="$LOCALIZE[32007]">
            <content source="favourites"/>
            <content source="settings"/>
            <content source="commands"/>
            <content source="addons" target="executable"/>
        </group>
    </groupings>
</menus>
