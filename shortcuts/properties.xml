    <button id="31028" property="widgetTags" title="Badges"/>
    <button id="31468" property="widgetTarget" title="Type de contenu"/>
    <button id="581" property="widgetSortBy" title="Trier par"/>
    <button id="580" property="widgetSortOrder" title="Ordre de tri"/>
    <button id="21427" property="widgetLimit" title="Nombre d'éléments"/>
