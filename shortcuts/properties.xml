<?xml version="1.0" encoding="utf-8"?>
<!-- Native Skin Shortcuts v3 property editors. Old button 404 is gone. -->
<properties>
  <property name="widget" type="widget"/>
  <property name="background" type="background"/>
  <property name="thumb" type="text"/>
  <property name="layout" type="options"><options>
    <option value="poster" label="Poster"/><option value="landscape" label="Landscape"/>
    <option value="square" label="Carré"/><option value="list" label="Liste"/>
  </options></property>
  <property name="widgetStyle" type="options"><options>
    <option value="default" label="Défaut"/><option value="poster" label="Poster"/>
