<?xml version="1.0" encoding="utf-8"?>
<!-- Skin Shortcuts v3 templates; the old v2 template.xml is intentionally unused.
     Each Bingie hub owns a v3 menu and emits its widgets into the original include. -->
<templates>
  <!-- Bingie Widgets: replaced legacy submenuOther/$SKINSHORTCUTS macros -->
  <template include="Widgets" menu="mainmenu">
    <condition>widgetPath</condition>
    <property name="contentStyle">normal</property>
    <property name="container">fixedlist</property>
    <property name="position">horizontal</property>
    <property name="width">100%</property>
    <property name="height">341</property>
    <property name="widgetStyle">default</property>
    <property name="widgetLimit">20</property>
    <property name="widgetTags">WidgetTagOverlayDisable</property>
    <property name="widgetTarget">videos</property>
    <controls>
      <include content="widget_header_multi">
        <param name="widgetid" value="$MATH[1500 + index]" />
        <param name="submenuid" value="$PROPERTY[name]" />
        <param name="widgetName" value="$PROPERTY[widgetLabel]" />
      </include>
      <include content="widget_base">
        <param name="contentStyle" value="$PROPERTY[contentStyle]" />
        <param name="widgetid" value="$MATH[1500 + index]" />
        <param name="container" value="$PROPERTY[container]" />
        <param name="position" value="$PROPERTY[position]" />
        <param name="width" value="$PROPERTY[width]" />
        <param name="height" value="$PROPERTY[height]" />
        <param name="widgetName" value="$PROPERTY[widgetLabel]" />
        <param name="submenuid" value="$PROPERTY[name]" />
        <param name="widgetTags" value="$PROPERTY[widgetTags]" />
        <param name="widgetTarget" value="$PROPERTY[widgetTarget]" />
        <param name="widgetPath" value="$PROPERTY[widgetPath]" />
        <param name="widgetStyle" value="widget_layout_$PROPERTY[widgetStyle]" />
        <param name="widgetSortBy" value="$PROPERTY[widgetSortBy]" />
        <param name="widgetSortOrder" value="$PROPERTY[widgetSortOrder]" />
        <param name="widgetLimit" value="$PROPERTY[widgetLimit]" />
      </include>
    </controls>
  </template>
